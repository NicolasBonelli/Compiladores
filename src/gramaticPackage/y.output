  90                              | TYPEDEF PAIR '<' DOUBLE '>' ';'
  91                              | TYPEDEF T_ASIGNACION tipo subrango ';'
  92                              | TYPEDEF T_ID T_ASIGNACION subrango ';'
  93                              | TYPEDEF T_ID T_ASIGNACION tipo ';'
  94                              | TYPEDEF T_ID tipo subrango ';'

  95  subrango : '{' T_CTE ',' T_CTE '}'
  96           | '{' '-' T_CTE ',' T_CTE '}'
  97           | '{' T_CTE ',' '-' T_CTE '}'
  98           | '{' '-' T_CTE ',' '-' T_CTE '}'
  99           | '{' '}'
 100           | error

 101  condicion : expresion comparador expresion
 102            | expresion error expresion
 103            | expresion comparador
 104            | comparador expresion

 105  comparador : MENOR_IGUAL
 106             | MAYOR_IGUAL
 107             | DISTINTO
 108             | '='
 109             | '<'
 110             | '>'

 111  asignacion : IDENTIFIER_LIST T_ASIGNACION expresion_list error
