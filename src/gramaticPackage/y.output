  91                              | TYPEDEF T_ID T_ASIGNACION subrango ';'
  92                              | TYPEDEF T_ID T_ASIGNACION tipo ';'
  93                              | TYPEDEF T_ID tipo subrango ';'

  94  subrango : '{' T_CTE ',' T_CTE '}'
  95           | '{' '-' T_CTE ',' T_CTE '}'
  96           | '{' T_CTE ',' '-' T_CTE '}'
  97           | '{' '-' T_CTE ',' '-' T_CTE '}'
  98           | '{' '}'
  99           | error

