  72         | OUTF '(' expresion ')'
  73         | OUTF '(' T_CADENA ')'
  74         | OUTF '(' sentencia ')' ';'
  75         | OUTF '(' ')' ';'

  76  sentencia_declarativa_tipos : TYPEDEF T_ID T_ASIGNACION tipo subrango ';'
  77                              | TYPEDEF PAIR '<' LONGINT '>' T_ID ';'
  78                              | TYPEDEF PAIR '<' DOUBLE '>' T_ID ';'
  79                              | TYPEDEF PAIR '<' '>' T_ID ';'
  80                              | TYPEDEF PAIR DOUBLE T_ID ';'
