   0  $accept : programa $end

   1  programa : nombre bloque_sentencias
   2           | T_ID
   3           | bloque_sentencias

   4  bloque_sentencias : BEGIN sentencias END
   5                    | BEGIN END

   6  sentencias : sentencia
   7             | sentencias sentencia

   8  sentencia : declaracion
   9            | asignacion
  10            | if_statement
  11            | repeat_while_statement
  12            | salida
  13            | declaracion_funcion
  14            | goto_statement
  15            | sentencia_declarativa_tipos
  16            | T_ETIQUETA
  17            | RET '(' expresion ')' ';'
  18            | RET '(' expresion ')'
  19            | RET '(' ')' ';'

  20  declaracion : tipo lista_var ';'
  21              | tipo lista_var error
  22              | tipo ';'

  23  lista_var : lista_var ',' T_ID
  24            | T_ID
  25            | lista_var T_ID

  26  nombre : T_ID

  27  encabezado_funcion : tipo FUN

  28  declaracion_funcion : encabezado_funcion nombre '(' parametro ')' bloque_sentencias
  29                      | encabezado_funcion nombre '(' parametros_error ')' bloque_sentencias
  30                      | encabezado_funcion nombre '(' tipo ')' bloque_sentencias
  31                      | tipo nombre '(' tipo T_ID ')' bloque_sentencias
  32                      | encabezado_funcion '(' tipo T_ID ')' bloque_sentencias
  33                      | encabezado_funcion nombre '(' parametro ')' bloque_sentencias ';'

  34  parametro : tipo T_ID

  35  parametros_error : parametro ',' parametro
  36                   | parametros_error ',' parametro
  37                   |

  38  repeat_sentencia : bloque_sentencias
  39                   | sentencia

  40  tipo : DOUBLE
  41       | LONGINT
  42       | T_ID

  43  signo_THEN : THEN

  44  signo_ELSE : ELSE

  45  bloque_THEN : signo_THEN repeat_sentencia

  46  bloque_THEN_CON_ELSE : signo_THEN repeat_sentencia

  47  bloque_ELSE : signo_ELSE repeat_sentencia

  48  if_statement : IF '(' condicion ')' bloque_THEN END_IF ';'
  49               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  50               | IF '(' condicion ')' bloque_THEN_CON_ELSE repeat_sentencia END_IF ';'
  51               | IF '(' condicion ')' bloque_THEN END_IF
  52               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF
  53               | IF '(' ')' bloque_THEN END_IF ';'
  54               | IF '(' ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  55               | IF '(' condicion ')' repeat_sentencia END_IF ';'
  56               | IF '(' condicion ')' repeat_sentencia bloque_ELSE END_IF ';'
  57               | IF '(' condicion ')' signo_THEN END_IF ';'
  58               | IF '(' condicion ')' signo_THEN signo_ELSE END_IF ';'
  59               | IF condicion bloque_THEN END_IF ';'
  60               | IF condicion bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  61               | IF '(' condicion ')' bloque_THEN error ';'
  62               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE error ';'

  63  inicio_while : REPEAT

  64  repeat_while_statement : inicio_while repeat_sentencia WHILE '(' condicion ')' ';'
  65                         | inicio_while repeat_sentencia WHILE '(' condicion ')'
  66                         | inicio_while WHILE '(' condicion ')'
  67                         | inicio_while repeat_sentencia WHILE '(' ')' ';'
  68                         | inicio_while repeat_sentencia WHILE condicion ';'
  69                         | inicio_while repeat_sentencia error '(' condicion ')' ';'

  70  salida : OUTF '(' T_CADENA ')' ';'
