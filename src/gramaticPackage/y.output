   0  $accept : programa $end

   1  programa : nombre bloque_sentencias
   2           | T_ID
   3           | bloque_sentencias
   4           |

   5  bloque_sentencias : BEGIN sentencias END
   6                    | BEGIN END

   7  sentencias : sentencia
   8             | sentencias sentencia

   9  sentencia : declaracion
  10            | asignacion
  11            | if_statement
  12            | repeat_while_statement
  13            | salida
  14            | declaracion_funcion
  15            | goto_statement
  16            | sentencia_declarativa_tipos
  17            | T_ETIQUETA
  18            | RET '(' expresion ')' ';'
  19            | RET '(' expresion ')'
  20            | RET '(' ')' ';'

  21  declaracion : tipo lista_var ';'
  22              | tipo lista_var error
  23              | tipo ';'

  24  lista_var : lista_var ',' T_ID
  25            | T_ID
  26            | lista_var T_ID

  27  nombre : T_ID

  28  encabezado_funcion : tipo FUN

  29  declaracion_funcion : encabezado_funcion nombre '(' parametro ')' bloque_sentencias
  30                      | encabezado_funcion nombre '(' parametros_error ')' bloque_sentencias
  31                      | encabezado_funcion nombre '(' tipo ')' bloque_sentencias
  32                      | tipo nombre '(' tipo T_ID ')' bloque_sentencias
  33                      | encabezado_funcion '(' tipo T_ID ')' bloque_sentencias
  34                      | encabezado_funcion nombre '(' parametro ')' bloque_sentencias ';'

  35  parametro : tipo T_ID

  36  parametros_error : parametro ',' parametro
  37                   | parametros_error ',' parametro
  38                   |

  39  repeat_sentencia : bloque_sentencias
  40                   | sentencia

  41  tipo : DOUBLE
  42       | LONGINT
  43       | T_ID

  44  signo_THEN : THEN

  45  signo_ELSE : ELSE

  46  bloque_THEN : signo_THEN repeat_sentencia

  47  bloque_THEN_CON_ELSE : signo_THEN repeat_sentencia

  48  bloque_ELSE : signo_ELSE repeat_sentencia

  49  if_statement : IF '(' condicion ')' bloque_THEN END_IF ';'
  50               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  51               | IF '(' condicion ')' bloque_THEN_CON_ELSE repeat_sentencia END_IF ';'
  52               | IF '(' condicion ')' bloque_THEN END_IF
  53               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF
  54               | IF '(' ')' bloque_THEN END_IF ';'
  55               | IF '(' ')' bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  56               | IF '(' condicion ')' repeat_sentencia END_IF ';'
  57               | IF '(' condicion ')' repeat_sentencia bloque_ELSE END_IF ';'
  58               | IF '(' condicion ')' signo_THEN END_IF ';'
  59               | IF '(' condicion ')' signo_THEN signo_ELSE END_IF ';'
  60               | IF condicion bloque_THEN END_IF ';'
  61               | IF condicion bloque_THEN_CON_ELSE bloque_ELSE END_IF ';'
  62               | IF '(' condicion ')' bloque_THEN error ';'
  63               | IF '(' condicion ')' bloque_THEN_CON_ELSE bloque_ELSE error ';'

  64  inicio_while : REPEAT

  65  repeat_while_statement : inicio_while repeat_sentencia WHILE '(' condicion ')' ';'
  66                         | inicio_while repeat_sentencia WHILE '(' condicion ')'
  67                         | inicio_while WHILE '(' condicion ')'
  68                         | inicio_while repeat_sentencia WHILE '(' ')' ';'
  69                         | inicio_while repeat_sentencia WHILE condicion ';'
  70                         | inicio_while repeat_sentencia error '(' condicion ')' ';'

  71  salida : OUTF '(' T_CADENA ')' ';'
  72         | OUTF '(' expresion ')' ';'
  73         | OUTF '(' expresion ')'
  74         | OUTF '(' T_CADENA ')'
  75         | OUTF '(' sentencia ')' ';'
  76         | OUTF '(' ')' ';'

  77  sentencia_declarativa_tipos : TYPEDEF T_ID T_ASIGNACION tipo subrango ';'
  78                              | TYPEDEF PAIR '<' LONGINT '>' T_ID ';'
  79                              | TYPEDEF PAIR '<' DOUBLE '>' T_ID ';'
  80                              | TYPEDEF PAIR '<' '>' T_ID ';'
  81                              | TYPEDEF PAIR DOUBLE T_ID ';'
  82                              | TYPEDEF PAIR LONGINT T_ID ';'
