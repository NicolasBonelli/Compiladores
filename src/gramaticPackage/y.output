 144            | expresion '*' expresion
 145            | expresion '/' expresion
 146            | T_CTE
 147            | T_ID
 148            | acceso_par
 149            | invocacion_funcion
 150            | unaria
 151            | error

 152  unaria : '-' T_CTE

