 130                 | GOTO T_ETIQUETA
 131                 | GOTO error

 132  invocacion_funcion : T_ID '(' parametro_real ')'
 133                     | T_ID '(' error ')'

 134  parametro_real : expresion_aritmetica

 135  expresion_aritmetica : expresion_aritmetica '+' expresion_aritmetica
